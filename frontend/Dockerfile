FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG NEXT_PUBLIC_API_URL=http://jiumozhi.tech:6986/api
ARG NEXT_PUBLIC_SITE_URL=http://jiumozhi.tech:6985
ARG NEXT_PUBLIC_DEV_AUTH_BYPASS=false
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_DEV_AUTH_BYPASS=$NEXT_PUBLIC_DEV_AUTH_BYPASS

RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
