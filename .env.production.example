# 生产环境 Docker Compose 变量
# 复制为 .env.production 后按需修改（可选，默认值已适配 jiumozhi.tech）

DOMAIN=jiumozhi.tech
FRONTEND_PORT=6985
BACKEND_PORT=6986
NEXT_PUBLIC_API_URL=http://jiumozhi.tech:6986/api
NEXT_PUBLIC_SITE_URL=http://jiumozhi.tech:6985
CORS_ORIGINS=http://jiumozhi.tech:6985

# 国内服务器拉 Docker Hub 慢时可改用镜像（./start.sh prod 默认已配置 DaoCloud）
# DOCKER_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
# DOCKER_NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# 阿里云专属加速器示例: https://xxxxxx.mirror.aliyuncs.com（在容器镜像服务控制台获取）
