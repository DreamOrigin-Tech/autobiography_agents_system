# 生产环境 backend/.env 模板（./start.sh prod 首次运行时可复制为 backend/.env）

LITELLM_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 数据持久化到 Docker volume
DATABASE_URL=sqlite+aiosqlite:////data/autobiography.db

# 允许公网前端域名跨域（含端口）
CORS_ORIGINS=http://jiumozhi.tech:6985

# 登录与会话
FRONTEND_URL=http://jiumozhi.tech:6985
PUBLIC_API_URL=http://jiumozhi.tech:6986
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=30
# ACCESS_PASSWORD=change-this-password

# 微信开放平台「网站应用」扫码登录
# WECHAT_APP_ID=wx-your-app-id
# WECHAT_APP_SECRET=your-app-secret
# WECHAT_REDIRECT_URI=http://jiumozhi.tech:6986/api/auth/wechat/callback
