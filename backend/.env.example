# OpenAI 示例
# LITELLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-your-openai-key

# DeepSeek 示例（推荐 V4）
LITELLM_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=sk-your-deepseek-key

DATABASE_URL=sqlite+aiosqlite:///./autobiography.db
CORS_ORIGINS=http://localhost:6985

# Qwen Audio TTS
DASHSCOPE_API_KEY=
TTS_MODEL=qwen-audio-3.0-tts-flash
TTS_VOICE=longanhuan_v3.6
TTS_FORMAT=mp3
TTS_SAMPLE_RATE=22050
TTS_VOLUME=50
TTS_RATE=0.95
TTS_PITCH=1.0
TTS_TIMEOUT_SECONDS=45
TTS_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# Qwen ASR
ASR_MODEL=qwen3-asr-flash
ASR_LANGUAGE=zh
ASR_ENABLE_ITN=false
ASR_TIMEOUT_SECONDS=60
ASR_MAX_AUDIO_BYTES=7000000
ASR_COMPATIBLE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# `./start.sh dev` 会临时自动开启；生产环境必须保持 false
DEV_AUTH_BYPASS=false

# 本地管理员回退登录（生产环境建议优先使用微信登录）
# ACCESS_PASSWORD=change-this-password
FRONTEND_URL=http://localhost:6985
PUBLIC_API_URL=http://localhost:6986
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# 微信开放平台「网站应用」扫码登录
# WECHAT_APP_ID=wx-your-app-id
# WECHAT_APP_SECRET=your-app-secret
# WECHAT_REDIRECT_URI=http://localhost:6986/api/auth/wechat/callback
# 生产环境见 .env.production.example，部署命令: ./start.sh prod
